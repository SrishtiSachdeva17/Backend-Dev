<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Success</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; margin-top: 50px; }
        .success-box { display: inline-block; padding: 30px; border: 1px solid #4CAF50; border-radius: 5px; background-color: #f9fff9; }
        h1 { color: #4CAF50; }
        a { text-decoration: none; color: #007bff; }
    </style>
</head>
<body>
    <div class="success-box">
        <h1>Thank You, <%= name %>!</h1>
        <p>Your message has been received.</p>
        <p>We will get back to you at <strong><%= email %></strong> shortly.</p>
        <br>
        <a href="/">&larr; Back to Contact Form</a>
    </div>
</body>
</html>
