<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Employee Details</title>
	<style>
		table { width: 100%; border-collapse: collapse; }
		th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
		th { background-color: #f2f2f2; }
		.actions { display: flex; gap: 10px; }
		.btn { padding: 4px 8px; border: none; border-radius: 4px; cursor: pointer; }
		.btn-edit { background: #4CAF50; color: white; }
		.btn-delete { background: #f44336; color: white; }
	</style>
</head>
<body>
	<h2>Employee Details</h2>
	<a href="/employee/add" class="btn btn-edit">Add User</a>
	<table>
		<thead>
			<tr>
				<th>Profile</th>
				<th>Name</th>
				<th>Email</th>
				<th>Department</th>
				<th>Salary</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			<% employeeData.forEach(emp => { %>
				<tr>
					<td>
						<% if (emp.gender && emp.gender.toLowerCase() === 'female') { %>
							<img src="/images/woman.svg" alt="Female" width="40" height="40" style="border-radius:50%;background:#fff;" />
						<% } else { %>
							<img src="/images/man.svg" alt="Male" width="40" height="40" style="border-radius:50%;background:#fff;" />
						<% } %>
					</td>
					<td><%= emp.name %></td>
					<td><%= emp.email %></td>
					<td><%= emp.department %></td>
					<td><%= emp.basicSalary %></td>
					<td class="actions">
						<a href="/employee/edit/<%= emp.id %>" class="btn btn-edit">Edit</a>
						<form action="/api/employee/<%= emp.id %>?_method=DELETE" method="POST" style="display:inline;">
							<button type="submit" class="btn btn-delete">Delete</button>
						</form>
					</td>
				</tr>
			<% }) %>
		</tbody>
	</table>
</body>
</html>
