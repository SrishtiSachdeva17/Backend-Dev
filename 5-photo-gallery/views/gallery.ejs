<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photo Gallery</title>
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; margin: 0; padding: 20px; background-color: #fafafa; }
        h1 { text-align: center; color: #333; margin-bottom: 30px; }
        .gallery-container { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; max-width: 1000px; margin: 0 auto; }
        .gallery-item { background: white; padding: 10px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); text-align: center; }
        .gallery-item img { max-width: 100%; height: auto; border-radius: 4px; display: block; margin-bottom: 10px; }
        .gallery-item p { margin: 0; color: #555; font-weight: bold; }
    </style>
</head>
<body>
    <h1>My Photo Gallery</h1>
    <div class="gallery-container">
        <% images.forEach(function(image) { %>
            <div class="gallery-item">
                <img src="<%= image.src %>" alt="<%= image.alt %>">
                <p><%= image.title %></p>
            </div>
        <% }); %>
    </div>
</body>
</html>
